diff --git a/app/services/population_service.py b/app/services/population_service.py
new file mode 100644
index 0000000..159d157
--- /dev/null
+++ b/app/services/population_service.py
@@ -0,0 +1,38 @@
+"""전국 65세 이상 주민등록인구(행정안전부 주민등록 인구통계)."""
+
+import re
+from pathlib import Path
+
+from app.errors import ServiceError
+from app.models import ElderlyPopulation
+from app.services.data_files import ELDERLY_POPULATION_FILE, read_csv, require_columns
+
+PERIOD = re.compile(r"^(\d{4})-(0[1-9]|1[0-2])$")
+
+
+def elderly_population(data_dir: Path | str | None = None) -> ElderlyPopulation:
+    """기준연월(YYYY-MM)과 65세 이상 인구수를 시간 순서로 돌려준다."""
+
+    data = read_csv(ELDERLY_POPULATION_FILE, data_dir)
+    require_columns(data, ELDERLY_POPULATION_FILE, ["기준연월", "65세이상_인구수"])
+    if data[["기준연월", "65세이상_인구수"]].isna().any().any():
+        raise ServiceError(f"{ELDERLY_POPULATION_FILE}에 비어 있는 값이 있어.", 500)
+    if data["기준연월"].duplicated().any():
+        raise ServiceError(f"{ELDERLY_POPULATION_FILE}에 같은 기준연월이 겹쳐 있어.", 500)
+
+    points = []
+    for _, row in data.iterrows():
+        match = PERIOD.match(str(row["기준연월"]).strip())
+        if not match:
+            raise ServiceError(
+                f"기준연월은 YYYY-MM 형식이어야 해: {row['기준연월']}", 500
+            )
+        points.append(
+            {
+                "year": int(match.group(1)),
+                "month": int(match.group(2)),
+                "population": int(row["65세이상_인구수"]),
+            }
+        )
+    points.sort(key=lambda point: (point["year"], point["month"]))
+    return ElderlyPopulation(points=points)
diff --git a/tests/test_population_service.py b/tests/test_population_service.py
new file mode 100644
index 0000000..20fbd14
--- /dev/null
+++ b/tests/test_population_service.py
@@ -0,0 +1,43 @@
+import pytest
+
+from app.errors import ServiceError
+from app.services import population_service
+from app.services.data_files import ELDERLY_POPULATION_FILE
+
+HEADER = "기준연월,65세이상_인구수"
+
+
+def test_sorts_and_splits_period(write_csv):
+    data_dir = write_csv(
+        ELDERLY_POPULATION_FILE, f"{HEADER}\n2026-10,300\n2022-12,100\n2023-12,200"
+    )
+    points = population_service.elderly_population(data_dir).points
+    assert [(p.year, p.month, p.population) for p in points] == [
+        (2022, 12, 100),
+        (2023, 12, 200),
+        (2026, 10, 300),
+    ]
+
+
+@pytest.mark.parametrize("period", ["2022/12", "202212", "2022-13", "2022-1"])
+def test_bad_period_is_error(write_csv, period):
+    data_dir = write_csv(ELDERLY_POPULATION_FILE, f"{HEADER}\n{period},100")
+    with pytest.raises(ServiceError, match="YYYY-MM"):
+        population_service.elderly_population(data_dir)
+
+
+def test_duplicate_period_is_error(write_csv):
+    data_dir = write_csv(ELDERLY_POPULATION_FILE, f"{HEADER}\n2022-12,100\n2022-12,101")
+    with pytest.raises(ServiceError, match="겹쳐"):
+        population_service.elderly_population(data_dir)
+
+
+def test_blank_value_is_error(write_csv):
+    data_dir = write_csv(ELDERLY_POPULATION_FILE, f"{HEADER}\n2022-12,")
+    with pytest.raises(ServiceError, match="비어"):
+        population_service.elderly_population(data_dir)
+
+
+def test_missing_file_is_service_error(tmp_path):
+    with pytest.raises(ServiceError):
+        population_service.elderly_population(tmp_path)
